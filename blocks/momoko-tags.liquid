{%- doc -%}
  Momoko: "new" (listed in the last N days), "rare" and "runway" (product tags) badges.
{%- enddoc -%}
{%- render 'momoko-tags', product: closest.product, days: block.settings.new_days, block: block -%}

{% schema %}
{
  "name": "Momoko: badges",
  "tag": null,
  "settings": [
    { "type": "range", "id": "new_days", "label": "Show \"new\" for (days)", "min": 1, "max": 30, "step": 1, "default": 14 }
  ],
  "presets": [{ "name": "Momoko: badges" }]
}
{% endschema %}
